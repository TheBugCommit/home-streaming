{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-streaming/events/torrent.enqueue.v1.json",
  "title": "torrent.enqueue",
  "description": "Published by core-api when an admin uploads a .torrent file. Consumed by torrent-worker.",
  "type": "object",
  "required": ["requestId", "contentType", "category", "torrentFileBase64", "submittedByUserId", "submittedAt"],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "contentType": { "type": "string", "enum": ["movie", "tv", "music"] },
    "category": { "type": "string", "enum": ["movies", "tv", "music"] },
    "torrentFileBase64": { "type": "string" },
    "submittedByUserId": { "type": "string", "format": "uuid" },
    "submittedAt": { "type": "string", "format": "date-time" }
  }
}
