# Host paths / general
VIDEOS_PATH=/home/penguin/Videos
TZ=Europe/Madrid

# Postgres
POSTGRES_USER=homestream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homestream

# NATS
NATS_URL=nats://nats:4222

# qBittorrent
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=change-me

# core-api
CORE_API_PORT=3000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
INTERNAL_API_KEY=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# Metadata providers
TMDB_API_KEY=change-me
MUSICBRAINZ_CONTACT=you@example.com

# Jellyfin (JELLYFIN_API_KEY / library ids are generated manually post-boot in the Jellyfin dashboard)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=change-me
JELLYFIN_MOVIES_LIBRARY_ID=change-me
JELLYFIN_TV_LIBRARY_ID=change-me
JELLYFIN_MUSIC_LIBRARY_ID=change-me

# Tdarr (library ids generated manually in the Tdarr UI once the three Libraries are created —
# see tdarr/flows/README.md)
TDARR_SERVER_URL=http://tdarr:8266
TDARR_MOVIES_LIBRARY_ID=change-me
TDARR_TV_LIBRARY_ID=change-me
TDARR_MUSIC_LIBRARY_ID=change-me

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me
