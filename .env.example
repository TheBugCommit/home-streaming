# Host paths / general
# Root of the media pipeline. Everything below lives inside it, and staging/ -> library/ MUST stay
# within a single bind mount: the kernel refuses rename(2) (and link(2)) across mount points with
# EXDEV, even on one filesystem, and the fallback (copy) would expose half-written files to whichever
# component is reading them.
#
#   downloads/incomplete/    qBittorrent's in-progress writes
#   downloads/{movies,tv}/   completed downloads; seeds live here forever
#   staging/{movies,tv}/     ffmpeg output; NOT visible to Jellyfin
#   library/{movies,tv}/     final, named for Jellyfin. Jellyfin's only (read-only) mount.
MEDIA_PATH=/home/penguin/Videos
TZ=Europe/Madrid

# Postgres
POSTGRES_USER=homestream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homestream
DATABASE_URL=postgresql://homestream:change-me@postgres:5432/homestream

# qBittorrent
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_API_KEY=qbt_......

# Backend auth
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# Metadata providers (identification). Register a free key at themoviedb.org -> Settings -> API.
# Both credential styles work: a v4 Read Access Token (JWT starting with eyJ) or a v3 API key
# (32 hex chars).
TMDB_API_KEY=change-me

# Jellyfin (JELLYFIN_API_KEY and the library ids are generated manually post-boot in the dashboard)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=change-me
JELLYFIN_MOVIES_LIBRARY_ID=change-me
JELLYFIN_TV_LIBRARY_ID=change-me

# Comma-separated origins allowed to call the API from a browser (the new frontend's dev server).
CORS_ORIGINS=http://localhost:5173

# Intel Quick Sync hardware transcoding.
# RENDER_DEVICE is the host's Intel render node. Its number varies per machine: on a host whose only
# GPU is the Intel iGPU it is usually renderD128, but with a discrete GPU present the Intel one can
# land on renderD129. Check which is which with:
#   for d in /sys/class/drm/renderD*/device; do \
#     echo "$(basename $(dirname $d)) $(cat $d/vendor)"; done      # 0x8086 = Intel
# The node is mapped into containers under the SAME path it has on the host; it cannot be renamed.
RENDER_DEVICE=/dev/dri/renderD128
# gid of the host's 'render' group (getent group render). Containers need it to open the node when
# it is mode 0660 root:render, which is the usual case.
RENDER_GID=989
